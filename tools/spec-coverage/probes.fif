// The probes of tools/spec-coverage (spec_coverage.py patterns): one small code per control-flow
// pattern, run by `ran_case` (TvmLean/Proofs/Check/Tactic.lean) from the start of an external
// message with the invariant `True`: the pattern is handled when every path of the run reaches its
// end. Prints one line per probe, "name base64-BOC"; tools/spec-coverage/probes.txt is its output:
//   fift -I <ton>/crypto/fift/lib -s tools/spec-coverage/probes.fif > tools/spec-coverage/probes.txt
// The stack at the start: balance, message value, message cell, body slice, -1 (external).
"Asm.fif" include

{ type space 0 boc+>B B>base64 type cr } : put   // ( cell name -- )

// the baseline
<{ NOP }>c "nop" put

// jumps and calls of ordinary continuations
<{ <{ 1 INT }> PUSHCONT EXECUTE DROP }>c "callx" put
<{ <{ 1 INT DROP }> PUSHCONT JMPX }>c "jmpx" put
<{ 1 INT 2 INT <{ ADD }> PUSHCONT 2 1 CALLXARGS DROP }>c "callxargs" put
<{ 1 INT 2 INT <{ ADD DROP }> PUSHCONT 2 JMPXARGS }>c "jmpxargs" put
<{ <{ 1 INT 2 INT 1 RETARGS }> PUSHCONT 0 1 CALLXARGS DROP }>c "retargs" put
<{ 1 INT <{ ADD }> PUSHCONT 1 1 SETCONTARGS 2 INT SWAP EXECUTE DROP }>c "closure-call" put
<{ 1 INT <{ ADD DROP }> PUSHCONT 1 1 SETCONTARGS 2 INT SWAP JMPX }>c "closure-jump" put
<{ <{ DROP }> PUSHCONT CALLCC }>c "callcc" put
<{ <{ 2DROP }> PUSHCONT 0 0 CALLCCARGS }>c "callccargs" put
<b <{ NOP }>c ref, b> "implicit-jmpref" put
<{ <{ 1 INT DROP }>c CALLREF }>c "callref" put
<{ <{ NOP }>c JMPREF }>c "jmpref" put
<{ -1 INT <{ NOP }>c IFJMPREF }>c "ifjmpref" put
<{ DROP DROP DROP 1 INT AND <{ NOP }> PUSHCONT <{ NOP }> PUSHCONT IFELSE }>c "ifelse-unknown" put
<{ <{ NOP }> PUSHCONT c1 POP RETALT }>c "retalt" put

// a variable count of arguments and values, closures, saved registers
<{ 5 INT <{ ADD DROP }> PUSHCONT 1 INT -1 INT SETCONTVARARGS 3 INT SWAP EXECUTE }>c "setcontvarargs" put
<{ x{} PUSHSLICE 0 INT -1 INT BLESSVARARGS EXECUTE }>c "blessvarargs" put
<{ 1 INT 2 INT <{ ADD }> PUSHCONT 2 INT 1 INT CALLXVARARGS DROP }>c "callxvarargs" put
<{ <{ 1 INT 2 INT 1 INT RETVARARGS }> PUSHCONT 0 1 CALLXARGS DROP }>c "retvarargs" put
<{ <{ 1 INT 2 INT 1 RETURNARGS }> PUSHCONT EXECUTE DROP }>c "returnargs" put
<{ <{ 1 INT 2 INT 1 INT RETURNVARARGS }> PUSHCONT EXECUTE DROP }>c "returnvarargs" put
<{ 1 INT 2 INT 1 RETURNARGS DROP }>c "returnargs-top" put
<{ 1 INT 2 INT 1 INT RETURNVARARGS DROP }>c "returnvarargs-top" put
<{ <{ DROP }> PUSHCONT 0 INT -1 INT CALLCCVARARGS }>c "callccvarargs" put
<{ <{ NOP }> PUSHCONT 1 SETCONTCTRMANY EXECUTE }>c "setcontctrmany" put
<{ <{ NOP }> PUSHCONT 1 INT SETCONTCTRMANYX EXECUTE }>c "setcontctrmanyx" put

// loops: constant and unknown counts, with and without a value carried on the stack
<{ 3 INT <{ NOP }> PUSHCONT REPEAT }>c "repeat-const" put
<{ DROP DROP DROP 255 INT AND <{ NOP }> PUSHCONT REPEAT }>c "repeat-unknown" put
<{ DROP DROP DROP 255 INT AND 0 INT SWAP <{ INC }> PUSHCONT REPEAT DROP }>c "repeat-data" put
<{ 0 INT <{ INC DUP 3 INT GEQ }> PUSHCONT UNTIL DROP }>c "until-const" put
<{ DROP DROP DROP 255 INT AND <{ DEC DUP 0 INT LEQ }> PUSHCONT UNTIL DROP }>c "until-data" put
<{ DROP DROP DROP 255 INT AND <{ DUP 0 INT GREATER }> PUSHCONT <{ DEC }> PUSHCONT WHILE DROP }>c "while-data" put
<{ <{ NOP }> PUSHCONT AGAIN }>c "again" put
<{ <{ RETALT }> PUSHCONT AGAINBRK }>c "againbrk" put
<{ DROP DROP DROP 255 INT AND REPEATEND NOP }>c "repeatend" put
<{ DROP DROP DROP 255 INT AND UNTILEND DEC DUP 0 INT LEQ }>c "untilend" put
<{ DROP DROP DROP 255 INT AND <{ DUP 0 INT GREATER }> PUSHCONT WHILEEND DEC }>c "whileend" put
<{ AGAINEND NOP }>c "againend" put
<{ DROP DROP DROP 255 INT AND <{ DUP 7 INT EQUAL <{ RETALT }> PUSHCONT IFJMP DEC }> PUSHCONT REPEATBRK }>c "repeatbrk" put
<{ DROP DROP DROP 255 INT AND <{ DEC DUP 0 INT LEQ }> PUSHCONT UNTILBRK DROP }>c "untilbrk" put
<{ DROP DROP DROP 255 INT AND <{ DUP 0 INT GREATER }> PUSHCONT <{ DEC }> PUSHCONT WHILEBRK DROP }>c "whilebrk" put
<{ DROP DROP DROP 3 INT AND <{ 3 INT <{ NOP }> PUSHCONT REPEAT }> PUSHCONT REPEAT }>c "loop-in-loop" put

// exceptions
<{ 100 THROW }>c "throw" put
<{ 5 INT 100 THROWARG }>c "throwarg" put
<{ DROP DROP DROP 1 INT AND 100 THROWIF }>c "throwif-unknown" put
<{ <{ 100 THROW }> PUSHCONT <{ 2DROP }> PUSHCONT TRY }>c "try-throw" put
<{ <{ NOP }> PUSHCONT <{ 2DROP }> PUSHCONT TRY }>c "try-nothrow" put
<{ 1 INT <{ DROP 100 THROW }> PUSHCONT <{ 2DROP }> PUSHCONT 1 0 TRYARGS }>c "tryargs" put
<{ DROP DROP DROP 255 INT AND 100 INT LESS 101 THROWIFNOT }>c "throwifnot-unknown" put

// procedures and the method dispatch (Fift's PROGRAM: SETCP0, DICTPUSHCONST, DICTIGETJMPZ)
PROGRAM{
  DECLPROC recv_internal
  DECLPROC recv_external
  DECLPROC helper
  helper PROC:<{ 1 INT DROP }>
  recv_internal PROC:<{ DROP }>
  recv_external PROC:<{ helper CALLDICT }>
}END>c "calldict" put
PROGRAM{
  DECLPROC recv_internal
  DECLPROC recv_external
  DECLPROC helper
  helper PROC:<{ 1 INT DROP }>
  recv_internal PROC:<{ DROP }>
  recv_external PROC:<{ helper JMPDICT }>
}END>c "jmpdict" put
PROGRAM{
  DECLPROC recv_internal
  DECLPROC recv_external
  DECLPROC helper
  helper PROC:<{ 1 INT DROP }>
  recv_internal PROC:<{ DROP }>
  recv_external PROC:<{ helper PREPAREDICT EXECUTE }>
}END>c "preparedict" put

// the child VM, the codepage
<{ 0 INT x{71} PUSHSLICE 0 RUNVM 2DROP }>c "runvm" put
<{ 0 INT x{71} PUSHSLICE 0 INT RUNVMX 2DROP }>c "runvmx" put
<{ 0 INT x{71} PUSHSLICE NEWC ENDC 4 RUNVM }>c "runvm-data" put
<{ 0 INT x{71} PUSHSLICE NIL 16 RUNVM }>c "runvm-c7" put
<{ 0 INT x{71} PUSHSLICE 1000 INT 8 RUNVM }>c "runvm-gas" put
<{ 0 INT x{71} PUSHSLICE 1000 INT 2000 INT 72 RUNVM }>c "runvm-gasmax" put
<{ 0 INT x{71} PUSHSLICE 1 INT 256 RUNVM }>c "runvm-retvals" put
<{ 0 INT x{71} PUSHSLICE NEWC ENDC 4 INT RUNVMX }>c "runvmx-data" put
<{ 0 INT x{71} PUSHSLICE NIL 16 INT RUNVMX }>c "runvmx-c7" put
<{ 0 INT x{71} PUSHSLICE 1000 INT 8 INT RUNVMX }>c "runvmx-gas" put
<{ 0 INT x{71} PUSHSLICE 1 INT 256 INT RUNVMX }>c "runvmx-retvals" put
<{ 1 SETCP NOP }>c "setcp1" put
<{ 0 INT SETCPX }>c "setcpx" put

// actions and registers
<{ <b b> PUSHREF 0 INT SENDRAWMSG }>c "sendrawmsg" put
<{ 0 INT 0 INT RAWRESERVE }>c "rawreserve" put
<{ <b b> PUSHREF 0 INT SENDMSG DROP }>c "sendmsg" put
<{ <{ NOP }>c PUSHREF SETCODE }>c "setcode" put
<{ <{ NOP }>c PUSHREF 0 INT SETLIBCODE }>c "setlibcode" put
<{ 0 INT 0 INT CHANGELIB }>c "changelib" put
<{ <b b> PUSHREF c4 POP }>c "c4-update" put
<{ <b b> PUSHREF c5 POP }>c "c5-update" put
<{ c7 PUSH c7 POP }>c "c7-update" put
<{ 1 INT 1 SETGLOB 1 GETGLOB DROP }>c "setglob" put
<{ COMMIT 100 THROW }>c "commit" put
<{ ACCEPT }>c "accept" put
<{ 10000 INT SETGASLIMIT }>c "setgaslimit" put

// dictionaries the run does not know (read from the message body), the configuration, c7
<{ DROP LDDICT DROP 5 INT SWAP 32 INT DICTUGET }>c "dictget-unknown" put
<{ DROP LDDICT DROP x{} PUSHSLICE 5 INT ROT 32 INT DICTUSET DROP }>c "dictset-unknown" put
<{ DROP LDDICT DROP 0 INT SWAP 32 INT DICTUGETNEXT }>c "dictgetnext-unknown" put
<{ DROP LDDICT DROP 32 INT DICTUMIN }>c "dictmin-unknown" put
<{ DROP LDDICT DROP 32 INT DICTUREMMIN }>c "dicturemmin-unknown" put
<{ DROP LDDICT DROP 32 INT DICTIMAXREF }>c "dictimaxref-unknown" put
<{ DROP LDDICT DROP 32 INT DICTREMMAX }>c "dictremmax-unknown" put
<{ DROP LDDICT DROP -5 INT SWAP 32 INT DICTIGETPREVEQ }>c "dictigetpreveq-unknown" put
<{ DROP LDDICT DROP x{00000000} PUSHSLICE SWAP 32 INT DICTGETNEXT }>c "dictgetnext-slice-unknown" put
<{ DROP LDDICT DROP NEWC 5 INT ROT 32 INT DICTUSETB }>c "dictusetb-unknown" put
<{ DROP LDDICT DROP x{} PUSHSLICE 5 INT ROT 32 INT DICTIADD }>c "dictiadd-unknown" put
<{ DROP LDDICT DROP NEWC ENDC 5 INT ROT 32 INT DICTUSETREF }>c "dictusetref-unknown" put
<{ DROP LDDICT DROP NEWC 5 INT ROT 32 INT DICTUREPLACEB }>c "dictureplaceb-unknown" put
<{ DROP LDDICT DROP NEWC 5 INT ROT 32 INT DICTIREPLACEB }>c "dictireplaceb-unknown" put
<{ 9 INT CONFIGPARAM }>c "configparam" put
<{ 9 INT CONFIGOPTPARAM DROP }>c "configoptparam" put
<{ NOW DROP }>c "now" put
<{ GASCONSUMED DROP }>c "gasconsumed-v4" put

// the environment: randomness and globals in c7, the fee getters (from version 6: the
// configuration's prices through c7), message addresses of a slice the run does not know (the body)
<{ RANDU256 DROP }>c "randu256" put
<{ 100 INT RAND DROP }>c "rand" put
<{ 5 INT SETRAND }>c "setrand" put
<{ 5 INT ADDRAND }>c "addrand" put
<{ 1 INT 2 INT SETGLOBVAR 2 INT GETGLOBVAR DROP }>c "globvar" put
<{ 100 INT 0 INT GETGASFEE DROP }>c "getgasfee" put
<{ 1 INT 100 INT 10 INT 0 INT GETSTORAGEFEE DROP }>c "getstoragefee" put
<{ 1 INT 100 INT 0 INT GETFORWARDFEE DROP }>c "getforwardfee" put
<{ 100 INT 0 INT GETORIGINALFWDFEE DROP }>c "getoriginalfwdfee" put
<{ 100 INT 0 INT GETGASFEESIMPLE DROP }>c "getgasfeesimple" put
<{ 1 INT 100 INT 0 INT GETFORWARDFEESIMPLE DROP }>c "getforwardfeesimple" put
<{ GETPRECOMPILEDGAS DROP }>c "getprecompiledgas" put
<{ DROP REWRITESTDADDR 2DROP }>c "rewritestdaddr" put
<{ DROP REWRITEVARADDR 2DROP }>c "rewritevaraddr" put
<{ DROP PARSEMSGADDR DROP }>c "parsemsgaddr" put
<{ DROP LDMSGADDR 2DROP }>c "ldmsgaddr" put
<{ DROP LDMSGADDRQ DROP DROP }>c "ldmsgaddrq" put
// wave 7: the specifications of instructions of the corpus codes
<{ 5 INT 7 INT 3 MULRSHIFT# DROP }>c "mulrshift-const" put
<{ DROP 32 LDU DROP 1000 INT 8 MULRSHIFTR# DROP }>c "mulrshiftr-const" put
<{ DROP 32 LDU DROP 1000 INT 8 MULRSHIFT#MOD 2DROP }>c "mulrshiftmod-const" put
<{ 100 INT THROWANY }>c "throwany" put
<{ DROP 32 LDU DROP 100 INT SWAP THROWANYIF }>c "throwanyif" put
<{ DROP 32 LDU DROP 100 INT SWAP THROWANYIFNOT }>c "throwanyifnot" put
<{ 1 INT 100 INT THROWARGANY }>c "throwargany" put
<{ DROP 32 LDU DROP 1 INT 100 INT ROT THROWARGANYIF }>c "throwarganyif" put
<{ 8 INT SDCUTFIRST DROP }>c "sdcutfirst" put
<{ 8 INT SDCUTLAST DROP }>c "sdcutlast" put
<{ 8 INT SDSKIPLAST DROP }>c "sdskiplast" put
<{ x{71} SDBEGINS DROP }>c "sdbegins" put
<{ x{71} SDBEGINSQ 2DROP }>c "sdbeginsq" put
<{ SDEPTH DROP }>c "sdepth" put
<{ DROP CDEPTH DROP }>c "cdepth" put
<{ DROP XCTOS 2DROP }>c "xctos" put
<{ x{} PUSHSLICE BLESS EXECUTE }>c "bless" put
<{ SAMEALTSAVE RETALT }>c "samealtsave-retalt" put
<{ c2 SAVECTR }>c "savectr" put
<{ c4 SAVECTR }>c "savectr4" put
<{ SHA256U DROP }>c "sha256u" put
<{ 3 GETGLOB DROP }>c "getglob" put
<{ DROP REWRITESTDADDRQ }>c "rewritestdaddrq" put
