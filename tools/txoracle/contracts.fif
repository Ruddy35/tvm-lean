// Real contracts for the transaction oracle (Tests/Tx/Real.lean): the code the reference compiles
// from FunC (crypto/smartcont/auto/*.fif), their initial data and messages signed with a fixed key
// (wallet v3, highload wallet v2, the elector, the configuration contract).
// Prints one line per cell, "name base64-BOC"; tools/txoracle/contracts.txt is its output:
//   fift -I <ton>/crypto/fift/lib:<ton>/crypto/smartcont:<ton>/storage/storage-daemon/smartcont \
//     -s tools/txoracle/contracts.fif > tools/txoracle/contracts.txt
"Asm.fif" include
"TonUtil.fif" include

{ type space 0 boc+>B B>base64 type cr } : put   // ( cell name -- )

1700000200 constant NOW            // `now` of the transaction cases (Tests/Tx/Gen.lean)
B{4242424242424242424242424242424242424242424242424242424242424242} constant pk
B{1313131313131313131313131313131313131313131313131313131313131313} constant pk-other
pk priv>pub constant pub
variable key   pk key !
0x2222222222222222222222222222222222222222222222222222222222222222 constant dest  // 0:2222..22

// helpers of highload-wallet-v2.fif
{ tuck <s 2dup 1 s-fits-with? not rot over 1 i, -rot
  { drop swap ref, } { s, nip } cond
} : append-msg-body
{ <b b{01} s, rot 1 i, b{000100} s, 2swap addr, rot Gram,
  0 9 64 32 + + 1+ u, swap append-msg-body b>
} : create-int-msg                   // ( ng wc addr bounce body-builder -- msg )
{ 0 dest true <b 0 32 u, b> create-int-msg } : transfer   // ( ng -- msg ): a simple transfer to 0:2222..22

// ( addr body -- ext-msg ): the body signed with `key` (the signature first), to 0:addr
{ dup hashu key @ ed25519_sign_uint
  <b b{1000100} s, 0 4 roll addr, 0 Gram, b{00} s, swap B, swap <s s, b>
} : signed-ext
// ( addr init body -- ext-msg ): the same with the StateInit `init`
{ dup hashu key @ ed25519_sign_uint
  <b b{1000100} s, 0 5 roll addr, 0 Gram, b{10} s, 3 roll <s s, b{0} s, swap B, swap <s s, b>
} : signed-ext-init

// --- wallet v3 (wallet3-code.fc): seqno subwallet_id public_key; a message is
// signature subwallet_id valid_until seqno, then (mode ^msg)*
"auto/wallet3-code.fif" include constant w3code
698983191 constant w3sub
<b 0 32 u, w3sub 32 u, pub B, b> constant w3data
<b b{0011} s, w3code ref, w3data ref, null dict, b> constant w3init
w3init hashu constant w3addr
w3code "wallet3.code" put
w3data "wallet3.data" put
<b w3addr 256 u, b> "wallet3.addr" put
// ( sub valid seqno mode msg -- body )
{ <b 5 roll 32 u, 4 roll 32 u, 3 roll 32 u, rot 8 u, swap ref, b> } : w3order
{ w3addr swap signed-ext } : w3ext
w3sub 1800000000 0 3 500000000 transfer w3order w3ext "wallet3.msg.ok" put
w3sub 1800000000 0 1 500000000 transfer w3order w3ext "wallet3.msg.pay-fees" put
w3sub 1800000000 0 128 0 transfer w3order w3ext "wallet3.msg.all" put
w3sub 1800000000 0 160 0 transfer w3order w3ext "wallet3.msg.destroy" put
w3sub 1800000000 0 2 5000000000000 transfer w3order w3ext "wallet3.msg.too-much-ignored" put
w3sub 1800000000 0 0 5000000000000 transfer w3order w3ext "wallet3.msg.too-much" put
w3sub 1690000000 0 3 500000000 transfer w3order w3ext "wallet3.msg.expired" put
w3sub 1800000000 7 3 500000000 transfer w3order w3ext "wallet3.msg.seqno" put
1 1800000000 0 3 500000000 transfer w3order w3ext "wallet3.msg.subwallet" put
pk-other key !
w3sub 1800000000 0 3 500000000 transfer w3order w3ext "wallet3.msg.bad-signature" put
pk key !
<b w3sub 32 u, -1 32 i, 0 32 u, b> w3ext "wallet3.msg.no-order" put
w3addr w3init <b w3sub 32 u, -1 32 i, 0 32 u, b> signed-ext-init "wallet3.msg.deploy" put
w3addr w3init w3sub 1800000000 0 3 500000000 transfer w3order signed-ext-init "wallet3.msg.deploy-transfer" put

// --- highload wallet v2 (highload-wallet-v2-code.fc): subwallet_id last_cleaned public_key
// old_queries; a message is signature subwallet_id query_id orders (HashmapE 16 (mode ^msg)),
// query_id = expiry time << 32 + n
"auto/highload-wallet-v2-code.fif" include constant hlcode
0 constant hlsub
<b hlsub 32 u, 0 64 u, pub B, null dict, b> constant hldata
<b b{0011} s, hlcode ref, hldata ref, null dict, b> hashu constant hladdr
hlcode "highload2.code" put
hldata "highload2.data" put
<b hladdr 256 u, b> "highload2.addr" put
variable orders
{ dictnew orders ! } : no-orders
{ -rot <b rot 8 u, swap ref, b> <s swap orders @ 16 udict!+ not abort"cannot add order" orders ! } : order  // ( mode msg i -- )
{ <b hlsub 32 i, swap 64 u, orders @ dict, b> hladdr swap signed-ext } : hlext   // ( query_id -- msg )
NOW 60 + 32 << constant qid
no-orders 3 100000000 transfer 0 order 1 200000000 transfer 1 order
qid 1 + hlext "highload2.msg.two" put
no-orders 3 100000000 transfer 0 order 1 200000000 transfer 1 order 128 0 transfer 2 order
  2 1000 transfer 7 order 0 5000000000000 transfer 9 order
qid 2 + hlext "highload2.msg.five" put
no-orders qid 3 + hlext "highload2.msg.none" put
no-orders 3 100000000 transfer 0 order
NOW 100 - 32 << 4 + hlext "highload2.msg.expired" put
pk-other key ! qid 5 + hlext "highload2.msg.bad-signature" put pk key !
// the data after query qid + 1 was processed (last_cleaned 0), and one of a query 70 s old
dictnew <b b> <s qid 1 + rot 64 udict!+ drop
  <b b> <s NOW 70 - 32 << rot 64 udict!+ drop constant hlseen
<b hlsub 32 u, 0 64 u, pub B, hlseen dict, b> "highload2.data.seen" put

// --- elector (elector-code.fc), with the data of gen-zerostate.fif: no elections, credits, past
// elections; 0 grams; active_id 0, active_hash 0
"auto/elector-code.fif" include constant elcode
elcode "elector.code" put
<b 0 1 1+ 1+ 4 + 32 + u, 0 256 u, b> "elector.data" put

// --- the configuration contract (config-code.fc). Its data (the configuration dictionary, seqno,
// public_key, vote_dict) and its messages (to the address of parameter 0) are made in
// Tests/Tx/Real.lean; printed here: its code, the public key and the signed bodies of external
// messages, signature action seqno valid_until payload
"auto/config-code.fif" include constant cfgcode
cfgcode "config.code" put
<b pub B, b> "key.pub" put
{ dup hashu key @ ed25519_sign_uint <b swap B, swap <s s, b> } : signed-body   // ( body -- signed )
{ <b 3 roll 32 u, rot 32 u, swap 32 u, } : cfghead   // ( action seqno valid_until -- builder )
0x43665021 0 1800000000 cfghead 100 32 i, <b 0x1234 16 u, b> ref, b> signed-body "config.body.set-param" put
0x50624b21 0 1800000000 cfghead pk-other priv>pub B, b> signed-body "config.body.set-key" put
0x4e436f64 0 1800000000 cfghead cfgcode ref, b> signed-body "config.body.set-code" put
0x4e43ef05 0 1800000000 cfghead elcode ref, b> signed-body "config.body.elector-code" put
0 0 1800000000 cfghead b> signed-body "config.body.noop" put
0x12345678 0 1800000000 cfghead b> signed-body "config.body.unknown" put
0x43665021 5 1800000000 cfghead 100 32 i, <b 0x1234 16 u, b> ref, b> signed-body "config.body.seqno" put
0x43665021 0 1690000000 cfghead 100 32 i, <b 0x1234 16 u, b> ref, b> signed-body "config.body.expired" put
0x566f7465 0 1800000000 cfghead 0 16 u, 0 256 u, b> signed-body "config.body.vote" put
pk-other key !
0x43665021 0 1800000000 cfghead 100 32 i, <b 0x1234 16 u, b> ref, b> signed-body "config.body.bad-signature" put
pk key !

// --- manual DNS (dns-manual-code.fc): contract_id last_cleaned public_key root old_queries, the
// root a prefix-code dictionary of names (zeros count ++ name) to dictionaries of categories; a
// message is signature contract_id query_id ops (op:6 ..., continued in the last reference),
// sent with the body in a reference
"auto/dns-manual-code.fif" include constant dnscode
11 constant dnsid
<b dnsid 32 u, 0 64 u, pub B, null dict, null dict, b> constant dnsdata
<b b{0011} s, dnscode ref, dnsdata ref, null dict, b> hashu constant dnsaddr
dnscode "dns.code" put
dnsdata "dns.data" put
<b dnsaddr 256 u, b> "dns.addr" put
{ swap 0 1 u, over $len 1+ 6 u, swap $, 0 8 u, } : name,            // ( b S -- b' ): S and a zero byte, inline
{ 3 roll 11 6 u, 3 roll 256 u, rot name, 1 1 u, swap ref, } : set-op,   // ( b cat S value -- b' )
{ rot 12 6 u, rot 256 u, swap name, } : del-cat-op,                  // ( b cat S -- b' )
{ swap 22 6 u, swap name, } : del-name-op,                           // ( b S -- b' )
{ swap 21 6 u, swap name, 0 1 u, } : clear-table-op,                 // ( b S -- b' )
{ rot 1 6 u, rot 8 u, swap ref, } : send-op,                         // ( b mode msg -- b' )
// ( addr body -- ext-msg ): the body signed with `key`, in a reference
{ dup hashu key @ ed25519_sign_uint <b swap B, swap <s s, b>
  <b b{1000100} s, 0 3 roll addr, 0 Gram, b{01} s, swap ref, b>
} : signed-ext-ref
{ <b dnsid 32 u, NOW 60 + 32 << rot + 64 u, } : dnshead   // ( n -- b ): the query n
{ dnsaddr swap signed-ext-ref } : dnsext
1 dnshead 1 "test" <b 0x1234 16 u, b> set-op, b> dnsext "dns.msg.set" put
// set test/1, test/2, tesla/1, a/7; delete test/1; delete tesla; clear zz; send 0.1
<b 3 100000000 transfer send-op, b>
<b "zz" clear-table-op, swap ref, b>
<b "tesla" del-name-op, swap ref, b>
<b 1 "test" del-cat-op, swap ref, b>
<b 7 "a" <b 7 8 u, b> set-op, swap ref, b>
<b 1 "tesla" <b 3 8 u, b> set-op, swap ref, b>
<b 2 "test" <b 2 8 u, b> set-op, swap ref, b>
2 dnshead 1 "test" <b 1 8 u, b> set-op, swap ref, b> dnsext "dns.msg.multi" put
3 dnshead 31 6 u, 0 1 u, b> dnsext "dns.msg.root-null" put
4 dnshead 32 6 u, b> dnsext "dns.msg.root-clear" put
5 dnshead 51 6 u, pk-other priv>pub B, b> dnsext "dns.msg.set-key" put
6 dnshead 50 6 u, b> dnsext "dns.msg.bad-op" put
7 dnshead 11 6 u, 1 256 u, 0 1 u, 2 6 u, <b 65 8 u, 66 8 u, b> <s s, 0 1 u, b> dnsext "dns.msg.bad-name" put
8 dnshead 9 6 u, dnscode ref, b> dnsext "dns.msg.set-code" put
<b dnsid 32 u, NOW 100 - 32 << 9 + 64 u, 0 6 u, b> dnsext "dns.msg.expired" put
<b 12 32 u, NOW 60 + 32 << 10 + 64 u, 0 6 u, b> dnsext "dns.msg.wrong-id" put
pk-other key ! 11 dnshead 0 6 u, b> dnsext "dns.msg.bad-signature" put pk key !

// --- simple wallet (simple-wallet-code.fc): seqno public_key; a message is signature seqno
// [mode ^msg]; wallet v2 (wallet-code.fc): seqno public_key; signature seqno valid_until (mode ^msg)*
{ <b b{0011} s, rot ref, swap ref, null dict, b> hashu } : addr-of   // ( code data -- addr )
"auto/simple-wallet-code.fif" include constant swcode
<b 0 32 u, pub B, b> constant swdata
swcode swdata addr-of constant swaddr
swcode "simple-wallet.code" put  swdata "simple-wallet.data" put  <b swaddr 256 u, b> "simple-wallet.addr" put
{ swaddr swap signed-ext } : swext
<b 0 32 u, 3 8 u, 500000000 transfer ref, b> swext "simple-wallet.msg.ok" put
<b 0 32 u, b> swext "simple-wallet.msg.none" put
<b 3 32 u, 3 8 u, 500000000 transfer ref, b> swext "simple-wallet.msg.seqno" put
pk-other key ! <b 0 32 u, 3 8 u, 500000000 transfer ref, b> swext "simple-wallet.msg.bad-signature" put pk key !
"auto/wallet-code.fif" include constant w2code
<b 0 32 u, pub B, b> constant w2data
w2code w2data addr-of constant w2addr
w2code "wallet2.code" put  w2data "wallet2.data" put  <b w2addr 256 u, b> "wallet2.addr" put
{ w2addr swap signed-ext } : w2ext
<b 0 32 u, 1800000000 32 u, 3 8 u, 100000000 transfer ref, 1 8 u, 200000000 transfer ref,
   0 8 u, 5000000000000 transfer ref, 2 8 u, 300000000 transfer ref, b> w2ext "wallet2.msg.four" put
<b 0 32 u, 1800000000 32 u, b> w2ext "wallet2.msg.none" put
<b 0 32 u, NOW 32 u, 3 8 u, 100000000 transfer ref, b> w2ext "wallet2.msg.expired" put
<b 1 32 u, 1800000000 32 u, 3 8 u, 100000000 transfer ref, b> w2ext "wallet2.msg.seqno" put
pk-other key ! <b 0 32 u, 1800000000 32 u, 3 8 u, 100000000 transfer ref, b> w2ext "wallet2.msg.bad-signature" put pk key !

// --- proof-of-work test giver (pow-testgiver-code.fc): seqno subwallet public_key seed complexity
// last_success ^(amount target_delta min_cpl max_cpl); "Mine" messages (unsigned, the hash of the
// body below the complexity), "RScl" (rescale the complexity), signed transfers
"auto/pow-testgiver-code.fif" include constant pgcode
{ <b 0 32 u, 77 32 u, pub B, 0x1234 128 u, swap 256 u, NOW 100 - 32 u,
     <b 1000000000 Gram, 5 32 u, 8 8 u, 250 8 u, b> ref, b> } : pgdata   // ( complexity -- data )
1 252 << pgdata constant pgeasy   // complexity 2^252 (the messages below are mined for it)
pgcode pgeasy addr-of constant pgaddr
pgcode "pow.code" put  pgeasy "pow.data.easy" put  1 pgdata "pow.data.hard" put  <b pgaddr 256 u, b> "pow.addr" put
{ <b b{1000100} s, 0 pgaddr addr, 0 Gram, b{01} s, swap ref, b> } : pgext   // ( body -- ext-msg ), not signed
// ( expire rseed rdata -- body ): Mine for 0:2222..22 (flags 0)
{ <b 0x4d696e65 32 u, 0 8 i, 3 roll 32 u, dest 256 u, over 256 u, rot 128 u, swap 256 u, b> } : mine
// ( expire rseed -- body ): the first rdata from 1 whose body hashes below 2^252
variable rd
{ 0 rd ! { rd @ 1+ rd ! 2dup rd @ mine hashu 1 252 << < } until rd @ mine } : mine-solved
NOW 30 + 0x1234 mine-solved pgext "pow.msg.mine" put
NOW 30 + 0x9999 mine-solved pgext "pow.msg.mine-wrong-seed" put
NOW 5 - 0x1234 mine-solved pgext "pow.msg.mine-expired" put
<b 0x5253636c 32 u, NOW 10 - 32 u, b> pgext "pow.msg.rescale" put
<b 0x5253636c 32 u, NOW 10 + 32 u, b> pgext "pow.msg.rescale-early" put
<b 77 32 u, NOW 100 + 32 u, 0 32 u, 500000000 transfer ref, 3 8 u, b> pgaddr swap signed-ext "pow.msg.transfer" put

// --- multisig (multisig-code.fc): wallet_id n k last_cleaned owner_infos (i -> public_key flood)
// pending_queries; a message is signature(root) i signatures wallet_id query_id (mode ^msg)*, the
// signatures a chain of (signature j ^next) over the hash of the query; an empty message
// initializes. Owners 0, 1, 2 are the fixed key and two more.
"auto/multisig-code.fif" include constant mscode
B{2121212121212121212121212121212121212121212121212121212121212121} constant pk1
B{3131313131313131313131313131313131313131313131313131313131313131} constant pk2
{ <b rot B, 0 8 u, b> <s swap rot 8 udict!+ drop } : owner+   // ( D pub i -- D' ): public_key, flood 0
dictnew pub 0 owner+ pk1 priv>pub 1 owner+ pk2 priv>pub 2 owner+ constant owners
NOW 3700 + 32 << constant msq                  // a query not yet due for an hour
<b 77 32 u, msq 1 + 64 u, 3 8 u, 500000000 transfer ref, b> constant msquery
// ( k pending owners -- data ), ( k pending -- data )
{ <b 77 32 u, 3 8 u, 3 roll 8 u, 0 64 u, swap dict, swap dict, b> } : msdata-o
{ owners msdata-o } : msdata
// the owners after owner 0 created a query (its flood 1)
dictnew <b pub B, 1 8 u, b> <s 0 rot 8 udict!+ drop pk1 priv>pub 1 owner+ pk2 priv>pub 2 owner+ constant owners-q
// the query msquery pending, signed by owner 0 (cnt 1, cnt_bits 001)
dictnew <b 1 1 u, 0 8 u, 1 8 u, 1 3 u, msquery <s 32 64 + u@+ nip s, b> <s msq 1 + rot 64 udict!+ drop constant mspending
{ <b rot 8 u, swap dict, swap <s s, b> } : msroot   // ( query i signatures -- body ): signed by owner i
{ rot hashu swap ed25519_sign_uint <b swap B, swap 8 u, null dict, b> } : cosign   // ( query j key -- signature j )
1 null msdata constant ms1data   mscode ms1data addr-of constant ms1addr
2 null msdata constant ms2data   mscode ms2data addr-of constant ms2addr
mscode "multisig.code" put
ms1data "multisig.data.k1" put  <b ms1addr 256 u, b> "multisig.addr.k1" put
ms2data "multisig.data.k2" put  <b ms2addr 256 u, b> "multisig.addr.k2" put
2 mspending owners-q msdata-o "multisig.data.k2-pending" put
<b b{1000100} s, 0 ms2addr addr, 0 Gram, b{00} s, b> "multisig.msg.init" put
ms1addr msquery 0 null msroot signed-ext "multisig.msg.k1-send" put
ms2addr msquery 0 null msroot signed-ext "multisig.msg.k2-root" put
ms2addr msquery 0 msquery 1 pk1 cosign msroot signed-ext "multisig.msg.k2-cosigned" put
pk1 key ! ms2addr msquery 1 null msroot signed-ext "multisig.msg.k2-confirm" put pk key !
ms2addr msquery 7 null msroot signed-ext "multisig.msg.unknown-owner" put
pk2 key ! ms2addr msquery 0 null msroot signed-ext "multisig.msg.bad-signature" put pk key !
ms2addr <b 78 32 u, msq 2 + 64 u, 3 8 u, 500000000 transfer ref, b> 0 null msroot signed-ext "multisig.msg.wrong-wallet" put
ms2addr <b 77 32 u, NOW 10 - 32 << 64 u, 3 8 u, 500000000 transfer ref, b> 0 null msroot signed-ext "multisig.msg.expired" put
ms2addr <b 77 32 u, NOW 100 + 32 << 64 u, 3 8 u, 500000000 transfer ref, b> 0 null msroot signed-ext "multisig.msg.too-soon" put

// --- restricted wallet v3 (restricted-wallet3-code.fc): seqno subwallet public_key, then the final
// public key (before the first message) or start_at and the schedule rdict (int32 seconds since
// start_at -> grams kept); start_at 0 reads it from configuration parameter -13
"auto/restricted-wallet3-code.fif" include constant rwcode
dictnew
  <b 900000000 Gram, b> <s -10 rot 32 idict!+ drop
  <b 800000000 Gram, b> <s 0 rot 32 idict!+ drop
  <b 100000000 Gram, b> <s 1000 rot 32 idict!+ drop constant rwsched
<b 0 32 u, 5 32 u, pub B, pub B, b> constant rwdata0
rwcode rwdata0 addr-of constant rwaddr
rwcode "restricted3.code" put  rwdata0 "restricted3.data.new" put  <b rwaddr 256 u, b> "restricted3.addr" put
<b 1 32 u, 5 32 u, pub B, NOW 500 - 32 u, rwsched dict, b> "restricted3.data.started" put
<b 1 32 u, 5 32 u, pub B, 0 32 u, rwsched dict, b> "restricted3.data.from-config" put
{ rwaddr swap signed-ext } : rwext
<b 5 32 u, 1800000000 32 u, 0 32 u, NOW 500 - 32 u, rwsched dict, b> rwext "restricted3.msg.init" put
<b 5 32 u, 1800000000 32 u, 1 32 u, 3 8 u, 500000000 transfer ref, b> rwext "restricted3.msg.transfer" put
<b 5 32 u, 1800000000 32 u, 1 32 u, 3 8 u, 50000000 transfer ref, b> rwext "restricted3.msg.transfer-small" put
<b 5 32 u, 1800000000 32 u, 1 32 u, 0 8 u, 5000000000000 transfer ref, b> rwext "restricted3.msg.transfer-too-much" put
<b 5 32 u, 1800000000 32 u, 4 32 u, 3 8 u, 50000000 transfer ref, b> rwext "restricted3.msg.seqno" put
<b 6 32 u, 1800000000 32 u, 1 32 u, 3 8 u, 50000000 transfer ref, b> rwext "restricted3.msg.subwallet" put
<b 5 32 u, NOW 32 u, 1 32 u, 3 8 u, 50000000 transfer ref, b> rwext "restricted3.msg.expired" put
pk-other key ! <b 5 32 u, 1800000000 32 u, 1 32 u, 3 8 u, 50000000 transfer ref, b> rwext "restricted3.msg.bad-signature" put pk key !

// --- payment channel (payment-channel-code.fc): data ^config ^state; config: timeouts 100 100,
// A's key (the fixed one), B's key (pk1), A's and B's addresses, channel 99, min_A_extra 0; states
// init (none signed, signed by A, signed by A and expired), close (none signed, signed by A with
// promises 0.3 and 0.1, the same expired) and payout. Bodies: pchan_cmd, A's and B's signatures
// (Maybe ^signature) over the message, the message; init messages for internal delivery
"auto/payment-channel-code.fif" include constant pccode
pk1 priv>pub constant pub1
<b b{100} s, 0 8 i, dest 256 u, b> constant pc-a
<b b{100} s, 0 8 i, 0x4444444444444444444444444444444444444444444444444444444444444444 256 u, b> constant pc-b
<b 100 32 u, 100 32 u, pub B, pub1 B, pc-a ref, pc-b ref, 99 64 u, 0 Gram, b> constant pccfg
{ <b pccfg ref, swap ref, b> } : pcdata   // ( state -- data )
<b 0 3 i, 0 1 i, 0 1 i, 0 Gram, 0 Gram, 0 32 u, 0 Gram, 0 Gram, b> pcdata constant pc-init
pccode pc-init addr-of constant pcaddr
pccode "pchan.code" put  <b pcaddr 256 u, b> "pchan.addr" put
pc-init "pchan.data.init" put
<b 0 3 i, -1 1 i, 0 1 i, 0 Gram, 0 Gram, NOW 50 + 32 u, 2000000000 Gram, 0 Gram, b> pcdata "pchan.data.init-a" put
<b 0 3 i, -1 1 i, 0 1 i, 0 Gram, 0 Gram, NOW 10 - 32 u, 2000000000 Gram, 0 Gram, b> pcdata "pchan.data.init-expired" put
<b 1 3 i, 0 1 i, 0 1 i, 0 Gram, 0 Gram, 0 32 u, 2000000000 Gram, 1000000000 Gram, b> pcdata "pchan.data.close" put
<b 1 3 i, -1 1 i, 0 1 i, 300000000 Gram, 100000000 Gram, NOW 50 + 32 u, 2000000000 Gram, 1000000000 Gram, b> pcdata "pchan.data.close-a" put
<b 1 3 i, -1 1 i, 0 1 i, 300000000 Gram, 100000000 Gram, NOW 10 - 32 u, 2000000000 Gram, 1000000000 Gram, b> pcdata "pchan.data.close-expired" put
<b 2 3 i, 2000000000 Gram, 1000000000 Gram, b> pcdata "pchan.data.payout" put
variable pcm
// ( msg a? b? -- body ): signed by A if a?, by B if b?
{ rot pcm ! <b 0x912838d1 32 u, rot { -1 1 i, <b pcm @ hashu pk ed25519_sign_uint B, b> ref, } { 0 1 i, } cond
  swap { -1 1 i, <b pcm @ hashu pk1 ed25519_sign_uint B, b> ref, } { 0 1 i, } cond pcm @ <s s, b> } : pcwrap
// ( inc_A inc_B channel -- msg )
{ <b 0x27317822 32 u, 3 roll Gram, rot Gram, 0 Gram, 0 Gram, swap 64 u, b> } : pcinit
2000000000 0 99 pcinit true false pcwrap "pchan.body.init-a" put
0 1000000000 99 pcinit false true pcwrap "pchan.body.init-b" put
2000000000 1000000000 99 pcinit true true pcwrap "pchan.body.init-both" put
2000000000 0 98 pcinit true false pcwrap "pchan.body.init-wrong-channel" put
5000000000 0 99 pcinit true false pcwrap "pchan.body.init-too-much" put
<b 0x43278a28 32 u, b> false false pcwrap "pchan.body.timeout" put
<b 99 64 u, 300000000 Gram, 100000000 Gram, b> constant pcpromise
// ( key -- close message with the promise signed by key )
{ pcpromise hashu swap ed25519_sign_uint <b 0xf28ae183 32 u, 0 Gram, 0 Gram, -1 1 i, <b rot B, b> ref, pcpromise <s s, b> } : pcclose
pk1 pcclose true false pcwrap "pchan.body.close-a" put
pk pcclose false true pcwrap "pchan.body.close-b" put
<b 0xf28ae183 32 u, 0 Gram, 0 Gram, 0 1 i, pcpromise <s s, b> constant pcclose-nosig
pcclose-nosig true false pcwrap "pchan.body.close-a-nosig" put
pcclose-nosig true true pcwrap "pchan.body.close-both" put
<b 0x37fe7810 32 u, b> false false pcwrap "pchan.body.payout" put
<b 7 32 u, b> "pchan.body.unknown" put
<b 0 32 u, b> "pchan.body.transfer" put

// --- highload wallet v1 (highload-wallet-code.fc, new-highload-wallet.fif): seqno subwallet_id
// public_key; a message is signature subwallet_id valid_until seqno orders (HashmapE 16 (mode
// ^msg)), sent in the order of the signed keys from 0 (idict_get_next? from -1: an order at a key
// of 2^15 or more, negative, is not sent)
"auto/highload-wallet-code.fif" include constant hl1code
7 constant hl1sub
<b 0 32 u, hl1sub 32 i, pub B, b> constant hl1data
<b b{0011} s, hl1code ref, hl1data ref, null dict, b> constant hl1init
hl1init hashu constant hl1addr
hl1code "highload1.code" put
hl1data "highload1.data" put
<b hl1addr 256 u, b> "highload1.addr" put
// ( sub valid_until seqno -- ext-msg ) with the orders of `orders`
{ <b 3 roll 32 i, rot 32 u, swap 32 u, orders @ dict, b> hl1addr swap signed-ext } : hl1ext
// the message of new-highload-wallet.fif (valid_until -1, seqno 0, no orders) with the StateInit
hl1addr hl1init <b hl1sub 32 i, -1 32 i, 0 32 u, false 1 i, b> signed-ext-init "highload1.msg.init" put
no-orders 3 100000000 transfer 0 order 1 200000000 transfer 1 order
hl1sub 1800000000 0 hl1ext "highload1.msg.two" put
no-orders 3 100000000 transfer 0 order 1 200000000 transfer 1 order 128 0 transfer 2 order
  2 1000 transfer 7 order 0 5000000000000 transfer 9 order
hl1sub 1800000000 0 hl1ext "highload1.msg.five" put
no-orders 3 100000000 transfer 0 order 3 200000000 transfer 40000 order 3 300000000 transfer 32767 order
hl1sub 1800000000 0 hl1ext "highload1.msg.negative-key" put
no-orders hl1sub 1800000000 0 hl1ext "highload1.msg.none" put
no-orders 3 100000000 transfer 0 order
hl1sub NOW 0 hl1ext "highload1.msg.expired" put
hl1sub 1800000000 5 hl1ext "highload1.msg.seqno" put
8 1800000000 0 hl1ext "highload1.msg.subwallet" put
pk-other key ! hl1sub 1800000000 0 hl1ext "highload1.msg.bad-signature" put pk key !
hl1addr <b hl1sub 32 i, 1800000000 32 u, 0 32 u, orders @ dict, 5 8 u, b> signed-ext "highload1.msg.trailing" put

// --- simple wallet ext (simple-wallet-ext-code.fc): seqno public_key; a message is signature seqno
// [mode ^msg] (do_verify_message); after ACCEPT it sends the message of the first reference, and
// ENDS fails on a second reference or on more bits
"auto/simple-wallet-ext-code.fif" include constant swxcode
<b 0 32 u, pub B, b> constant swxdata
swxcode swxdata addr-of constant swxaddr
swxcode "simple-wallet-ext.code" put  swxdata "simple-wallet-ext.data" put  <b swxaddr 256 u, b> "simple-wallet-ext.addr" put
{ swxaddr swap signed-ext } : swxext
<b 0 32 u, 3 8 u, 500000000 transfer ref, b> swxext "simple-wallet-ext.msg.ok" put
<b 0 32 u, 128 8 u, 0 transfer ref, b> swxext "simple-wallet-ext.msg.all" put
<b 0 32 u, 0 8 u, 5000000000000 transfer ref, b> swxext "simple-wallet-ext.msg.too-much" put
<b 0 32 u, b> swxext "simple-wallet-ext.msg.none" put
<b 0 32 u, 3 8 u, 500000000 transfer ref, 3 8 u, 100000000 transfer ref, b> swxext "simple-wallet-ext.msg.two" put
<b 0 32 u, 3 8 u, 500000000 transfer ref, 1 1 u, b> swxext "simple-wallet-ext.msg.trailing" put
<b 3 32 u, 3 8 u, 500000000 transfer ref, b> swxext "simple-wallet-ext.msg.seqno" put
pk-other key ! <b 0 32 u, 3 8 u, 500000000 transfer ref, b> swxext "simple-wallet-ext.msg.bad-signature" put pk key !
// the StateInit of the wallet (create_init_state) with a transfer, to deploy it
swxaddr <b b{0011} s, swxcode ref, swxdata ref, null dict, b> <b 0 32 u, 3 8 u, 500000000 transfer ref, b> signed-ext-init "simple-wallet-ext.msg.deploy" put

// --- restricted wallet v1 (restricted-wallet-code.fc, new-restricted-wallet.fif; in the
// masterchain): seqno public_key; a message is signature seqno valid_until (mode ^msg)*; seqno 0 is
// accepted without a signature; while configuration parameter -13 is absent or later than now, only
// messages to the elector (parameter 1, -1:3333..33 in the testnet configuration of the cases) and
// external messages are sent
// ( addr body -- ext-msg ): signed-ext to -1:addr
{ dup hashu key @ ed25519_sign_uint
  <b b{1000100} s, -1 4 roll addr, 0 Gram, b{00} s, swap B, swap <s s, b>
} : signed-ext-mc
0x3333333333333333333333333333333333333333333333333333333333333333 constant elector
0x4444444444444444444444444444444444444444444444444444444444444444 constant other
{ true <b 0 32 u, b> create-int-msg } : transfer-to   // ( ng wc addr -- msg ): a simple transfer
// an external message to addr_extern 0xabcd (16 bits)
<b b{11} s, b{00} s, b{01} s, 16 9 u, 0xabcd 16 u, 0 64 u, 0 32 u, b{00} s, b> constant ext-out
"auto/restricted-wallet-code.fif" include constant rw1code
<b 0 32 u, pub B, b> constant rw1data0
<b b{0011} s, rw1code ref, rw1data0 ref, null dict, b> constant rw1init
rw1init hashu constant rw1addr
rw1code "restricted1.code" put  rw1data0 "restricted1.data.new" put  <b rw1addr 256 u, b> "restricted1.addr" put
<b 1 32 u, pub B, b> "restricted1.data" put
// the message of new-restricted-wallet.fif (a zero signature, seqno 0, valid_until -1) with the
// StateInit, and the same without it
<b b{1000100} s, -1 rw1addr addr, b{000010} s, rw1init <s s, b{0} s, 0 256 u, 0 256 u, 0 32 u, -1 32 i, b> "restricted1.msg.init" put
<b b{1000100} s, -1 rw1addr addr, 0 Gram, b{00} s, 0 256 u, 0 256 u, 0 32 u, -1 32 i, b> "restricted1.msg.init-noinit" put
{ rw1addr swap signed-ext-mc } : rw1ext
<b 1 32 u, 1800000000 32 u, 3 8 u, 100000000 -1 elector transfer-to ref, 3 8 u, 200000000 0 dest transfer-to ref,
   3 8 u, 50000000 -1 other transfer-to ref, 3 8 u, ext-out ref, b> rw1ext "restricted1.msg.four" put
<b 1 32 u, 1800000000 32 u, 3 8 u, 100000000 -1 elector transfer-to ref, b> rw1ext "restricted1.msg.elector" put
<b 1 32 u, 1800000000 32 u, 3 8 u, 100000000 0 elector transfer-to ref, b> rw1ext "restricted1.msg.elector-basechain" put
<b 1 32 u, 1800000000 32 u, 3 8 u, 200000000 0 dest transfer-to ref, b> rw1ext "restricted1.msg.basechain" put
<b 1 32 u, 1800000000 32 u, 0 8 u, 5000000000000 -1 elector transfer-to ref, b> rw1ext "restricted1.msg.too-much" put
<b 1 32 u, 1800000000 32 u, b> rw1ext "restricted1.msg.none" put
<b 4 32 u, 1800000000 32 u, 3 8 u, 100000000 -1 elector transfer-to ref, b> rw1ext "restricted1.msg.seqno" put
<b 1 32 u, NOW 32 u, 3 8 u, 100000000 -1 elector transfer-to ref, b> rw1ext "restricted1.msg.expired" put
pk-other key ! <b 1 32 u, 1800000000 32 u, 3 8 u, 100000000 -1 elector transfer-to ref, b> rw1ext "restricted1.msg.bad-signature" put pk key !

// --- restricted wallet v2 (restricted-wallet2-code.fc, new-restricted-wallet2.fif; in the
// masterchain): seqno public_key start_at rdict; rdict (int32 seconds since start_at -> grams kept)
// is looked up with idict_get_preveq? (32) at now - start_at (start_at 0: configuration parameter
// -13; absent: -1) and the value reserved with mode 2; a message is signature seqno valid_until
// (mode ^msg)*, seqno 0 accepted without a signature. new-restricted-wallet2.fif makes rdict with
// 16-bit keys (make-rdict below, as there: the nominal amount at -32768, 3/4 at 92, 1/2 at 183, 1/4
// at 366, 0 at 548); rw2sched has 32-bit keys
"auto/restricted-wallet2-code.fif" include constant rw2code
// D x t -- D'
{ <b rot Gram, swap rot 16 b>idict! not abort"cannot add value"
} : rdict-entry
// balance -- dict
{ dictnew
  over -32768 rdict-entry
  over 3/4 */ 92 rdict-entry
  over 1/2 */ 183 rdict-entry
  swap 1/4 */ 366 rdict-entry
  0 548 rdict-entry
} : make-rdict
1000000000 make-rdict constant rw2rdict
<b 0 32 u, pub B, 0 32 u, rw2rdict dict, b> constant rw2data0
<b b{0011} s, rw2code ref, rw2data0 ref, null dict, b> constant rw2init
rw2init hashu constant rw2addr
rw2code "restricted2.code" put  rw2data0 "restricted2.data.new" put  <b rw2addr 256 u, b> "restricted2.addr" put
<b 1 32 u, pub B, 0 32 u, rw2rdict dict, b> "restricted2.data.script" put
// -1: 0.9, 0: 0.8, 1000: 0.1, 100000: 0
dictnew
  <b 900000000 Gram, b> <s -1 rot 32 idict!+ drop
  <b 800000000 Gram, b> <s 0 rot 32 idict!+ drop
  <b 100000000 Gram, b> <s 1000 rot 32 idict!+ drop
  <b 0 Gram, b> <s 100000 rot 32 idict!+ drop constant rw2sched
<b 1 32 u, pub B, NOW 500 - 32 u, rw2sched dict, b> "restricted2.data.started" put
<b 1 32 u, pub B, NOW 500 + 32 u, rw2sched dict, b> "restricted2.data.not-started" put
<b 1 32 u, pub B, NOW 200000 - 32 u, rw2sched dict, b> "restricted2.data.unlocked" put
<b 1 32 u, pub B, 0 32 u, rw2sched dict, b> "restricted2.data.from-config" put
// the message of new-restricted-wallet2.fif (a zero signature, seqno 0, valid_until -1) with the
// StateInit, and the same without it
<b b{1000100} s, -1 rw2addr addr, b{000010} s, rw2init <s s, b{0} s, 0 256 u, 0 256 u, 0 32 u, -1 32 i, b> "restricted2.msg.init" put
<b b{1000100} s, -1 rw2addr addr, 0 Gram, b{00} s, 0 256 u, 0 256 u, 0 32 u, -1 32 i, b> "restricted2.msg.init-noinit" put
{ rw2addr swap signed-ext-mc } : rw2ext
<b 1 32 u, 1800000000 32 u, 3 8 u, 500000000 0 dest transfer-to ref, b> rw2ext "restricted2.msg.transfer" put
<b 1 32 u, 1800000000 32 u, 3 8 u, 50000000 0 dest transfer-to ref, b> rw2ext "restricted2.msg.transfer-small" put
<b 1 32 u, 1800000000 32 u, 3 8 u, 50000000 0 dest transfer-to ref, 3 8 u, 30000000 -1 other transfer-to ref, b> rw2ext "restricted2.msg.two" put
<b 1 32 u, 1800000000 32 u, 0 8 u, 5000000000000 0 dest transfer-to ref, b> rw2ext "restricted2.msg.transfer-too-much" put
<b 1 32 u, 1800000000 32 u, b> rw2ext "restricted2.msg.none" put
<b 4 32 u, 1800000000 32 u, 3 8 u, 50000000 0 dest transfer-to ref, b> rw2ext "restricted2.msg.seqno" put
<b 1 32 u, NOW 32 u, 3 8 u, 50000000 0 dest transfer-to ref, b> rw2ext "restricted2.msg.expired" put
pk-other key ! <b 1 32 u, 1800000000 32 u, 3 8 u, 50000000 0 dest transfer-to ref, b> rw2ext "restricted2.msg.bad-signature" put pk key !

// --- automatic DNS (dns-auto-code.fc, new-auto-dns.fif, auto-dns.fif): data ^ctl (the owner's
// workchain:8 and address:256, contract id:32) domains (HashmapE 224: string_hash of a name ending
// with a zero byte >> 32 -> expires_at:32 ^categories) gc (HashmapE 256: expires_at << 224 + key ->
// empty) stdperiod:30 ppr ppc ppb (Grams) next_housekeeping:32 last_housekeeping:32; categories
// (HashmapE 256 ^record) has the domain's owner at 0. The owner of the contract and of the domains
// is 0:2222..22 (the source of the cases' internal messages), another one 0:4444..44. An internal
// message is op:32 query_id:64 then the name (Maybe ^name, or a 6-bit length and the name inline,
// as auto-dns.fif writes it with `7 i,`), ^categories (not for prolong) and expires_at:32; the
// control operations (op >> 24 = 0x43) ChPr and CDel; gc: op query_id max_steps:int32
"auto/dns-auto-code.fif" include constant dacode
<b 0 8 i, dest 256 u, 0 32 i, b> constant dactl
1000000 constant dastd   // stdperiod, s
// ( dd gc stdperiod nhk lhk -- data ): ppr 0.1, ppc 0.001, ppb 0.000001 Gram
{ <b dactl ref, 5 roll dict, 4 roll dict, 3 roll 30 u, 100000000 Gram, 1000000 Gram, 1000 Gram, rot 32 u, swap 32 u, b>
} : dadata
null null dastd 0 0 dadata constant dadata0   // as new-auto-dns.fif makes it
<b b{0011} s, dacode ref, dadata0 ref, null dict, b> constant dainit
dainit hashu constant daaddr
dacode "dnsauto.code" put  dadata0 "dnsauto.data.new" put  <b daaddr 256 u, b> "dnsauto.addr" put
// the message of new-auto-dns.fif (no body) with the StateInit
<b b{1000100} s, 0 daaddr addr, b{000010} s, dainit <s s, b{0} s, b> "dnsauto.msg.init" put
{ $>B B{00} B+ } : z$      // ( S -- B ): the name S and a zero byte
{ Bhashu 32 >> } : dkey    // ( B -- key ): its key in the domains
{ <b x{9fd3} s, -rot Addr, 0 8 u, b> } : smc-rec   // ( wc addr -- record ): dns_smc_address, as auto-dns.fif
// ( owner|null -- categories ): category 1 an ADNL address, category 0 the owner (unless null)
{ dictnew <b <b x{ad01} s, 0x55 256 u, 0 8 u, b> ref, 1 rot 256 b>udict! drop
  swap dup null? { drop } { <b swap ref, 0 rot 256 b>udict! drop } cond
} : cats
variable dd  variable gc
// ( B expires_at categories -- ): the name B in the domains, and its gc entry
{ rot dkey <b 3 pick 32 u, rot ref, over dd @ 224 b>udict! drop dd !
  swap 224 << or <b swap gc @ 256 b>udict! drop gc !
} : dom+
{ 224 << swap dkey or <b swap gc @ 256 b>udict! drop gc ! } : gc+   // ( B expires_at -- ): a gc entry only
0 dest smc-rec constant own
0 other smc-rec constant own2
// test, free (no owner), other (0:4444..44), bad2 and bad3 (owner records of 24 bits and with the
// tag 9fd2) expire in 500000 s, old and older expired 100 and 300 s ago; gc entries of test 200 s ago
// (as if left by a prolongation) and of a name not in the domains 250 s ago; housekeeping due (next
// 300 s ago, last 1000 s ago), recent (last 10 s ago), the contract disabled (stdperiod 0)
null dd ! null gc !
"test" z$ NOW 500000 + own cats dom+
"free" z$ NOW 500000 + null cats dom+
"other" z$ NOW 500000 + own2 cats dom+
"bad2" z$ NOW 500000 + <b x{9fd3} s, 0 8 u, b> cats dom+
"bad3" z$ NOW 500000 + <b x{9fd2} s, b{100} s, 0 8 i, dest 256 u, 0 8 u, b> cats dom+
"old" z$ NOW 100 - own cats dom+
"older" z$ NOW 300 - own cats dom+
"test" z$ NOW 200 - gc+
"gone" z$ NOW 250 - gc+
dd @ gc @ dastd NOW 300 - NOW 1000 - dadata "dnsauto.data.registered" put
dd @ gc @ dastd NOW 300 - NOW 10 - dadata "dnsauto.data.recent" put
dd @ gc @ 0 NOW 300 - NOW 1000 - dadata "dnsauto.data.disabled" put
// after the initialization message (next housekeeping 2^32 - 1), and only expired names
null null dastd 0xffffffff NOW 1000 - dadata "dnsauto.data.init" put
null dd ! null gc !
"old" z$ NOW 100 - own cats dom+
"older" z$ NOW 300 - own cats dom+
dd @ gc @ dastd NOW 300 - NOW 1000 - dadata "dnsauto.data.expired" put
0x72656764 constant regd  0x70726f6c constant prol  0x75706464 constant updd  0x676f6763 constant gogc
NOW 1000000 + constant daexp
{ <b swap 32 u, 1 64 u, } : daop                     // ( op -- b ): op and query_id 1
{ swap over Blen 7 u, swap B, } : dom,                // ( b B -- b' ): the name inline
{ <b swap B, b> swap 1 1 u, swap ref, } : domref,     // ( b B -- b' ): the name in a reference
{ rot daop rot dom, swap ref, daexp 32 u, b> } : dabody   // ( op B categories -- body )
{ prol daop swap dom, daexp 32 u, b> } : daprol       // ( B -- body ): prolong
regd "new" z$ own cats dabody "dnsauto.body.reg-new" put
regd "test" z$ own cats dabody "dnsauto.body.reg-test" put
regd "old" z$ own cats dabody "dnsauto.body.reg-old" put
regd "test" z$ "sub" z$ B+ own cats dabody "dnsauto.body.reg-sub" put
regd "free" z$ "x" z$ B+ own2 cats dabody "dnsauto.body.reg-free-sub" put
regd daop "ref" z$ domref, own cats ref, daexp 32 u, b> "dnsauto.body.reg-ref" put
regd daop 0 7 u, own cats ref, daexp 32 u, b> "dnsauto.body.reg-empty" put
regd "abc" $>B own cats dabody "dnsauto.body.reg-no-zero" put
regd daop <b 0x616 12 u, b> swap 1 1 u, swap ref, own cats ref, daexp 32 u, b> "dnsauto.body.reg-ref-bits" put
regd daop "abcdefghijklmnop" z$ domref, own cats ref, daexp 32 u, b> "dnsauto.body.reg-ref-long" put
regd daop <b "r" z$ B, <b b> ref, b> swap 1 1 u, swap ref, own cats ref, daexp 32 u, b> "dnsauto.body.reg-ref-refs" put
regd "a" z$ "b" z$ B+ "c" z$ B+ "d" z$ B+ own cats dabody "dnsauto.body.reg-four-zeros" put
regd "a" z$ "b" z$ B+ "c" z$ B+ "d" z$ B+ "e" z$ B+ own cats dabody "dnsauto.body.reg-five-zeros" put
regd "bad" z$ <b x{9fd3} s, 0 8 u, b> cats dabody "dnsauto.body.reg-bad-owner" put
regd "bad" z$ <b x{9fd2} s, b{100} s, 0 8 i, dest 256 u, 0 8 u, b> cats dabody "dnsauto.body.reg-bad-owner-tag" put
// categories of 103 cells (compute_data_size counts at most 100)
<b <b b> { <b swap ref, b> } 101 times ref, 1 dictnew 256 b>udict! drop constant big-cats
regd "big" z$ big-cats dabody "dnsauto.body.reg-big" put
regd daop "nodata" z$ dom, b> "dnsauto.body.reg-no-data" put
regd daop "noexp" z$ dom, own cats ref, b> "dnsauto.body.reg-no-expiry" put
regd "bad2" z$ own cats dabody "dnsauto.body.reg-bad2" put
regd "bad3" z$ "x" z$ B+ own cats dabody "dnsauto.body.reg-bad3-sub" put
"test" z$ daprol "dnsauto.body.prolong-test" put
"old" z$ daprol "dnsauto.body.prolong-old" put
"nothere" z$ daprol "dnsauto.body.prolong-missing" put
updd "test" z$ own2 cats dabody "dnsauto.body.update-test" put
updd "nothere" z$ own cats dabody "dnsauto.body.update-missing" put
<b gogc 32 u, 1 64 u, -1 32 i, b> "dnsauto.body.gc-all" put
<b gogc 32 u, 1 64 u, 1 32 i, b> "dnsauto.body.gc-one" put
<b gogc 32 u, 1 64 u, 0 32 i, b> "dnsauto.body.gc-zero" put
<b 0x12345678 32 u, 1 64 u, b> "dnsauto.body.unknown" put
<b 0x12345678 32 u, b> "dnsauto.body.unknown-no-qid" put
<b 0x80000001 32 u, 1 64 u, b> "dnsauto.body.answer" put
<b 0 32 u, "hi" $, b> "dnsauto.body.comment" put
<b 0x1234 16 u, b> "dnsauto.body.short" put
<b 0x43685072 32 u, 1 64 u, 2000000 32 u, 200000000 Gram, 2000000 Gram, 2000 Gram, b> "dnsauto.body.chpr" put
<b 0x4344656c 32 u, 1 64 u, b> "dnsauto.body.cdel" put
<b 0x54616b65 32 u, 1 64 u, 100000000 Gram, b> "dnsauto.body.take" put
<b 0x43000001 32 u, 1 64 u, b> "dnsauto.body.ctl-unknown" put

// --- the storage contract of TON Storage (storage/storage-daemon/smartcont/storage-contract.fc): the
// code func -SPA made of it (storage-contract.fif, found on the include path), which is
// storage-contract-code.boc (its hash below); its data and messages are made in
// Tests/Tx/StorageContract.lean
"storage-contract.fif" include constant stcode
stcode hashu 0xb4f9d928599d2f9be748f8a04af86a3cb2ff2053634df62b275545f6152b1d1a <>
  abort"storage-contract.fif is not storage-contract-code.boc"
stcode "storage.code" put
