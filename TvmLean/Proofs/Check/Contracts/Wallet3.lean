/-! ## The runs, one theorem per kind of transaction -/

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The runs of an external message, global version from 4: a run that commits keeps the invariant. -/
theorem runs_ext (key sub : Nat) : ∀ bal val msg body,
    RunsKeep code (Stored key sub) (computePhaseStack bal val msg body true) (4 ≤ ·) := by
  ran_case [Contracts.Wallet3.Data.encode, Contracts.Wallet3.Data.WF]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The runs of an external message, global version below 4: a run that commits keeps the invariant. -/
theorem runs_extOld (key sub : Nat) : ∀ bal val msg body,
    RunsKeep code (Stored key sub) (computePhaseStack bal val msg body true) (· < 4) := by
  ran_case [Contracts.Wallet3.Data.encode, Contracts.Wallet3.Data.WF]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The runs of an internal message, global version from 4: a run that commits keeps the invariant. -/
theorem runs_int (key sub : Nat) : ∀ bal val msg body,
    RunsKeep code (Stored key sub) (computePhaseStack bal val msg body false) (4 ≤ ·) := by
  ran_case [Contracts.Wallet3.Data.encode, Contracts.Wallet3.Data.WF]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The runs of an internal message, global version below 4: a run that commits keeps the invariant. -/
theorem runs_intOld (key sub : Nat) : ∀ bal val msg body,
    RunsKeep code (Stored key sub) (computePhaseStack bal val msg body false) (· < 4) := by
  ran_case [Contracts.Wallet3.Data.encode, Contracts.Wallet3.Data.WF]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The runs of tick-tock, global version from 4: a run that commits keeps the invariant. -/
theorem runs_tt (key sub : Nat) : ∀ bal addr tock,
    RunsKeep code (Stored key sub) (tickTockStack bal addr tock) (4 ≤ ·) := by
  ran_case [Contracts.Wallet3.Data.encode, Contracts.Wallet3.Data.WF]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The runs of tick-tock, global version below 4: a run that commits keeps the invariant. -/
theorem runs_ttOld (key sub : Nat) : ∀ bal addr tock,
    RunsKeep code (Stored key sub) (tickTockStack bal addr tock) (· < 4) := by
  ran_case [Contracts.Wallet3.Data.encode, Contracts.Wallet3.Data.WF]

/-- **Every committed run keeps the invariant** (the obligation of `Reachable.code_fixed`). -/
theorem preserves (key sub : Nat) : ∀ data c4 c5, (Stored key sub) data → Ran code data c4 c5 →
    (Stored key sub) (some c4) ∧ ∀ c, ¬ActionIn c5 (.setCode c) :=
  ran_preserves_of (by rfl) (runs_ext key sub) (runs_extOld key sub) (runs_int key sub)
    (runs_intOld key sub) (runs_tt key sub) (runs_ttOld key sub)

/-- **The invariant over all transactions.** Under any configuration, if every start state has
an active account only with the code `code` and data satisfying the invariant, and every `StateInit`
the account may be deployed with has that code and such data, then every shard account reachable by
transactions has an active account only with the code `code` and data satisfying the invariant. -/
theorem reachable (key sub : Nat) {configRoot : Cell} {Init Start : Cell → Prop}
    (hstart : ∀ sa, Start sa → Good (fun code' data => code' = some code ∧ (Stored key sub) data) sa)
    (hdeploy : ∀ c si, Init c → Reader.runExact Account.Reader.stateInit c = some si →
      si.code = some code ∧ (Stored key sub) si.data)
    {sa : Cell} (h : Reachable configRoot Init Start sa) :
    Good (fun code' data => code' = some code ∧ (Stored key sub) data) sa :=
  Reachable.code_fixed hstart hdeploy (preserves key sub) h

end TvmLean.Contracts.Checked.Wallet3

