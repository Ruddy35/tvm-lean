/-! ## The runs, one theorem per kind of transaction -/

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The runs of an external message, global version from 4: a run that commits keeps the invariant, and every `SETCODE` it commits installs a code satisfying the condition. -/
theorem runs_ext (key : Nat) : ∀ bal val msg body,
    RunsKeepActs code (Inv key) (Acts ((Signed key) (some body))) (computePhaseStack bal val msg body true) (4 ≤ ·) := by
  ran_case [Data.encode]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The runs of an external message, global version below 4: a run that commits keeps the invariant, and every `SETCODE` it commits installs a code satisfying the condition. -/
theorem runs_extOld (key : Nat) : ∀ bal val msg body,
    RunsKeepActs code (Inv key) (Acts ((Signed key) (some body))) (computePhaseStack bal val msg body true) (· < 4) := by
  ran_case [Data.encode]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The runs of an internal message, global version from 4: a run that commits keeps the invariant, and every `SETCODE` it commits installs a code satisfying the condition. -/
theorem runs_int (key : Nat) : ∀ bal val msg body,
    RunsKeepActs code (Inv key) (Acts ((Signed key) (some body))) (computePhaseStack bal val msg body false) (4 ≤ ·) := by
  ran_case [Data.encode]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The runs of an internal message, global version below 4: a run that commits keeps the invariant, and every `SETCODE` it commits installs a code satisfying the condition. -/
theorem runs_intOld (key : Nat) : ∀ bal val msg body,
    RunsKeepActs code (Inv key) (Acts ((Signed key) (some body))) (computePhaseStack bal val msg body false) (· < 4) := by
  ran_case [Data.encode]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The runs of tick-tock, global version from 4: a run that commits keeps the invariant, and every `SETCODE` it commits installs a code satisfying the condition. -/
theorem runs_tt (key : Nat) : ∀ bal addr tock,
    RunsKeepActs code (Inv key) (Acts ((Signed key) none)) (tickTockStack bal addr tock) (4 ≤ ·) := by
  ran_case [Data.encode]

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The runs of tick-tock, global version below 4: a run that commits keeps the invariant, and every `SETCODE` it commits installs a code satisfying the condition. -/
theorem runs_ttOld (key : Nat) : ∀ bal addr tock,
    RunsKeepActs code (Inv key) (Acts ((Signed key) none)) (tickTockStack bal addr tock) (· < 4) := by
  ran_case [Data.encode]

/-- **Every committed run keeps the invariant**, and every `SETCODE` it commits installs a code
that the condition admits for the body of some message (`ran_installs_of`, the obligation of
`ReachableWhile.good_codes`). -/
theorem preserves (key : Nat) : ∀ data c4 c5, (Inv key) data → Ran code data c4 c5 →
    (Inv key) (some c4) ∧ ∀ c, ActionIn c5 (.setCode c) → Installable (Signed key) c :=
  ran_installs_of (by rfl) (runs_ext key) (runs_extOld key) (runs_int key)
    (runs_intOld key) (runs_tt key) (runs_ttOld key)

/-- **The invariant while the code is `code`, and the codes it installs.** Under any configuration,
if every start state has an active account with data satisfying the invariant when its code is
`code`, and with the code `code` or one the condition admits, and every `StateInit` the account may
be deployed with has the code `code` and such data, then in every shard account reachable by
transactions while the code is `code` (`ReachableWhile`), an active account with the code `code` has
data satisfying the invariant, and an active account has the code `code` or a code that the
condition admits for the body of some message (`Installable`). -/
theorem reachable (key : Nat) {configRoot : Cell} {Init Start : Cell → Prop}
    (hstart : ∀ sa, Start sa → Good (fun code' data => (code' = some code → (Inv key) data) ∧
      ∀ c, code' = some c → c = code ∨ Installable (Signed key) c) sa)
    (hdeploy : ∀ c si, Init c → Reader.runExact Account.Reader.stateInit c = some si →
      si.code = some code ∧ (Inv key) si.data)
    {sa : Cell} (h : ReachableWhile configRoot Init Start code sa) :
    Good (fun code' data => (code' = some code → (Inv key) data) ∧
      ∀ c, code' = some c → c = code ∨ Installable (Signed key) c) sa :=
  ReachableWhile.good_codes hstart hdeploy (preserves key) h

end TvmLean.Contracts.Checked.UpgradableWallet

